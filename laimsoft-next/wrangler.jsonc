{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laimsoft",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "25d7c4b7af6e35b01f330e37b3c2b622",
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "laimsoft-db",
      "database_id": "77f98d86-519e-4115-a67d-a30e5ae106a1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "laimsoft-blog-images"
    }
  ]
}
